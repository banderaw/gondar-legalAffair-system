# PostgreSQL Database Configuration
POSTGRES_DB=legalsystem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# Django Configuration
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
USE_SSL_REDIRECT=False

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Frontend Configuration
# For Docker: use relative path (nginx proxies /api to backend)
# For local dev: use http://127.0.0.1:8000/api
VITE_API_BASE_URL=/api

# Local Development (non-Docker) - Uncomment these for local runserver
# DB_HOST=localhost
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# VITE_API_BASE_URL=http://localhost:8000
